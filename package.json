{
  "name": "consoleflow",
  "version": "2.0.0",
  "description": "ConsoleFlow Local Desktop App - Angular Architecture",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve --port 4200",
    "build:web": "ng build",
    "watch:web": "ng build --watch --configuration development",
    "start": "npm run build:web && electron .",
    "start:fast": "electron .",
    "build": "npm run build:web && electron-builder --win portable"
  },
  "build": {
    "appId": "com.consoleflow.app",
    "productName": "Workspace-Hub",
    "files": [
      "main.js",
      "server.js",
      "navegacion.js",
      "controllers/**/*",
      "dist/consoleflow/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "Workspace-Hub.exe"
    }
  },
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "exceljs": "^4.4.0",
    "js-beautify": "^2.0.3",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@types/js-beautify": "^1.14.3",
    "@types/prismjs": "^1.26.6",
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "~5.5.2"
  }
}
